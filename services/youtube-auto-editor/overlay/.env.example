# Never place a real key in source code or commit it to Git.
NVIDIA_API_KEY=nvapi-REPLACE_ME
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_ASSET_API_BASE=https://api.nvcf.nvidia.com/v2/nvcf
NVIDIA_GLOBAL_MODEL=minimaxai/minimax-m3
NVIDIA_GLOBAL_TEMPERATURE=1.0
NVIDIA_GLOBAL_TOP_P=0.95
NVIDIA_GLOBAL_MAX_TOKENS=8192
NVIDIA_GLOBAL_THINKING_MODE=adaptive
NVIDIA_SEGMENT_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_SEGMENT_MEDIA_ENABLE_THINKING=false
NVIDIA_SEGMENT_TEXT_ENABLE_THINKING=true
NVIDIA_CLEANUP_ASSETS=true

YT_AUTO_EDITOR_CONFIG=./config.yaml
YT_AUTO_EDITOR_HOST=127.0.0.1
YT_AUTO_EDITOR_PORT=8787
HEATHER_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://heather-ai-assistant.vercel.app,https://heather-ai-assistant-web.vercel.app,https://heather-ai-assistant-7x6i6v747.vercel.app
NEXT_PUBLIC_YOUTUBE_AUTO_EDITOR_URL=http://127.0.0.1:8787

# Google OAuth desktop-app credentials downloaded from Google Cloud Console.
YOUTUBE_CLIENT_SECRET=./secrets/client_secret.json
YOUTUBE_TOKEN_FILE=./secrets/youtube_token.json
