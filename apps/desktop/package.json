{
  "name": "heather-desktop",
  "version": "0.6.0",
  "private": true,
  "description": "Heather macOS desktop application with a managed local video worker.",
  "main": "bootstrap.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check bootstrap.cjs && node --check main.cjs && node --check preload.cjs",
    "dist": "electron-builder --mac dmg zip --publish never"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.heather.personalassistant",
    "productName": "Heather",
    "asar": true,
    "files": [
      "bootstrap.cjs",
      "main.cjs",
      "preload.cjs",
      "settings.html",
      "README.md"
    ],
    "extraResources": [
      {
        "from": "../../services/youtube-auto-editor",
        "to": "youtube-auto-editor"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "10.15.0",
      "artifactName": "Heather-${version}-${arch}.${ext}",
      "extendInfo": {
        "LSApplicationCategoryType": "public.app-category.productivity",
        "NSHighResolutionCapable": true
      }
    },
    "dmg": {
      "title": "Heather ${version}",
      "sign": false,
      "format": "UDZO",
      "filesystem": "HFS+",
      "backgroundColor": "#11131a",
      "iconSize": 96,
      "iconTextSize": 13,
      "window": {
        "size": {
          "width": 560,
          "height": 380
        }
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
