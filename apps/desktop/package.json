{
  "name": "heather-desktop",
  "version": "0.5.0",
  "private": true,
  "description": "Heather macOS desktop shell with a managed local video worker.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.cjs && node --check preload.cjs",
    "dist": "electron-builder --mac dmg zip --publish never"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.heather.personalassistant",
    "productName": "Heather",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "settings.html",
      "README.md"
    ],
    "extraResources": [
      {
        "from": "../../services/youtube-auto-editor",
        "to": "youtube-auto-editor"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Heather-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Heather ${version}",
      "sign": false
    }
  }
}
