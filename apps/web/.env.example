# Server-only NVIDIA NIM fallback. Do not use NEXT_PUBLIC_ for these values.
LLM_PROVIDER=nvidia
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL_GENERAL=
NVIDIA_MODEL_RESEARCH=
NVIDIA_MODEL_FALLBACK=
LLM_MAX_OUTPUT_TOKENS=1200
LLM_RESEARCH_MAX_OUTPUT_TOKENS=900
LLM_TIMEOUT_MS=45000
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.3
LLM_MAX_INPUT_CHARS=12000
LLM_MAX_HISTORY_MESSAGES=12

# Optional Heather voice. Without this key, Heather falls back to browser TTS.
# ELEVENLABS_API_KEY=...
