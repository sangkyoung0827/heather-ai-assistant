# Ollama local model (recommended)
HEATHER_OLLAMA_BASE_URL=http://localhost:11434
HEATHER_OLLAMA_MODEL=gemma4:latest

# Optional server-only Agent Runtime. Never prefix these values with NEXT_PUBLIC_.
AGENT_RUNTIME_URL=
AGENT_RUNTIME_INTERNAL_TOKEN=

# Optional legacy aliases
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4:latest

# OpenAI is not used by default in the current Heather chat path.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# HEATHER_ALLOW_PAID_API=false
