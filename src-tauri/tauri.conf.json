{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heather AI Assistant",
  "version": "0.1.0",
  "identifier": "com.heather.aiassistant",
  "build": {
    "beforeDevCommand": "npm run dev:tauri-web",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run prepare:tauri-build",
    "frontendDist": "https://heather-ai-assistant.vercel.app"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Heather AI Assistant",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "heather-production-main",
        "heather-production-floating"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "resources/embedded-ollama": "embedded-ollama"
    }
  }
}
